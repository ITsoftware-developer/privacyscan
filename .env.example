# Voorbeeldinstellingen. Kopieer dit bestand naar .env en vul het aan.
# .env zelf staat in .gitignore, zodat je eigen gegevens nooit in Git belanden.

# Poort waarop de site draait: http://localhost:3000
PORT=3000

# 127.0.0.1 = alleen bereikbaar vanaf je eigen computer.
# Zet op 0.0.0.0 als je de site online zet (en dan alleen achter https).
HOST=127.0.0.1

# development of production. Met production gaan cookies alleen nog via https.
NODE_ENV=development

# Wie is verantwoordelijk voor de gegevens? Komt in de privacyverklaring (/privacy).
# Verplicht zodra de site online staat.
CONTACT_NAME=
CONTACT_EMAIL=

# Het adres van je site, voor de links in de mails. Online: het https-adres.
BASE_URL=http://localhost:3000

# Mail versturen. Leeg = een testpostvak op http://localhost:3000/dev/mails (alleen op
# je eigen computer). Met Mailpit: smtp://127.0.0.1:1025. Online is dit verplicht.
SMTP_URL=
MAIL_FROM=Privacyscan <noreply@localhost>

# Datalekken: het dashboard en de openbare e-mailcontrole op de startpagina gebruiken
# een van deze twee bronnen, en bij elk resultaat staat welke.
#
# 1. Have I Been Pwned (HIBP). Met een eigen, betaalde sleutel gaat elk adres naar HIBP:
#    haveibeenpwned.com/API/Key (een maandabonnement, opzegbaar). Bij elk resultaat staat een
#    bronvermelding naar HIBP; houd die erbij. Zonder sleutel werken alleen de testadressen,
#    zoals account-exists@hibp-integration-tests.com (daarvoor gebruikt de app hun testsleutel).
HIBP_API_KEY=

# 2. XposedOrNot: gratis en zonder sleutel, zodat echte adressen werken zonder abonnement.
#    De grens is 25 controles per uur en 100 per dag voor de hele site, en de makers bedoelen
#    hem voor persoonlijk gebruik en weinig verkeer. Heb je een HIBP_API_KEY, dan gebruikt de app
#    die en deze niet.
#    Leeg = aan op je eigen computer en uit zodra NODE_ENV=production. Zet "on" of "off" om dat
#    te veranderen.
FREE_BREACH_CHECK=

# Zoekdienst voor "Op het web": zoeken op je eigen naam.
#
# Zonder zoekdienst zoekt de site niet op het web, en verzint hij niets: de pagina's zeggen dat dan
# eerlijk. Voor echte resultaten gebruikt de site Brave Search (brave.com/search/api): maak een
# account, kies een abonnement voor de Search API en plak hier je sleutel. Op het moment van
# schrijven is er per maand een klein gratis tegoed (ongeveer 1.000 zoekopdrachten) en vraagt Brave
# om een creditcard bij het aanmelden; kijk op hun site voor de actuele prijzen.
#
# Zet de sleutel alleen hier, in dit bestand. Nooit in een chat, een mail of Git (.env staat in .gitignore).
#   - Je naam (en je woonplaats, als je die invult) gaat als zoekopdracht naar Brave. Je e-mailadres niet.
#   - De voorwaarden van Brave staan niet toe dat resultaten bewaard worden. Daarom blijven ze maar
#     30 minuten staan; alleen jouw keuzes (Dit ben ik / Dit ben ik niet / Weet ik niet) blijven
#     bewaard, als vingerafdruk van het adres, zonder het resultaat zelf.
#   - Resultaten van Brave mogen niet gebruikt worden om AI-modellen te trainen of te beoordelen.
BRAVE_API_KEY=

# Welke zoekdienst? Leeg = Brave als er een BRAVE_API_KEY is, anders geen zoekdienst.
#   brave  Brave Search (de sleutel is dan verplicht)
#   demo   verzonnen nepresultaten, alleen om de werking te zien. Er gaat niets naar buiten.
#          Laat dit niet aan staan als je echte resultaten wilt: dan blijf je nepdata zien.
#   none   bewust geen zoekdienst
SEARCH_PROVIDER=

# Alleen als je bij Brave een abonnement hebt waarin opslaan van resultaten is toegestaan:
# zet dit dan op "on". Leeg of "off": resultaten blijven maximaal 30 minuten staan.
BRAVE_STORAGE_RIGHTS=

# Op een openbare site (production) staat zoeken op naam uit, behalve voor de beheerder (OWNER_EMAIL hieronder).

# De beheerder: jouw eigen e-mailadres. Het account met precies dit adres, en alleen als het bevestigd
# is, komt op de beheerpagina (/beheerder), ook op je eigen computer. Na het inloggen kom je daar meteen.
# Op een openbare site (NODE_ENV=production) mag dit account bovendien als enige op naam zoeken. Dat is
# vertrouwen en geen bewijs: registreer jezelf met dit adres voordat je de site aan anderen laat zien.
# Leeg = geen beheerpagina, en online zoekt niemand op naam.
# Dit adres hoort alleen hier, in je eigen .env: niet in de code en niet in Git.
OWNER_EMAIL=
