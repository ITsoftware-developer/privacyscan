<%- include('partials/head', { title: 'Resultaten' }) %>

<section class="welcome">
  <h1>Resultaten</h1>
  <p class="lead">Wat we over jou gevonden hebben. <a href="/dashboard">Terug naar je dashboard</a></p>
</section>

<% if (notice) { %>
  <p class="alert alert-ok notice-top" role="status"><%= notice %></p>
<% } %>
<% if (error) { %>
  <p class="alert alert-error notice-top" role="alert"><%= error %></p>
<% } %>

<div class="results">
  <% if (failedJob && ['cancelled', 'cancelled_admin'].includes(failedJob.error)) { %>
    <div id="gestopt" class="report">
      <%- include('partials/engine', {
        heading: 'Je gestopte Deep Scan',
        sub: jobErrorText(failedJob.error),
        steps: failedJob.steps,
        footnote: 'Wat hij al gevonden had, staat hieronder. Wat nog niet gedaan was, staat als overgeslagen. Start hem gerust opnieuw vanaf je dashboard.',
      }) %>
    </div>
  <% } else if (failedJob) { %>
    <p class="alert alert-error notice-top" role="alert">
      Je laatste Deep Scan is niet afgemaakt (<%= jobErrorText(failedJob.error) %>). Er is niets verzonnen: start hem
      gerust opnieuw vanaf je <a href="/dashboard#deep-scan">dashboard</a>.
    </p>
  <% } %>
  <% if (job) { %>
    <div id="rapport" class="report">
      <%- include('partials/engine', {
        heading: 'Je Deep Scan loopt',
        sub: job.status === 'queued' ? 'In de wachtrij' : 'Bezig',
        steps: job.steps,
        footnote: 'Het onderzoek loopt op de achtergrond: je mag deze pagina sluiten. Zolang hij open is, ververst hij zichzelf.',
      }) %>
      <% if (job.cancelRequested) { %>
        <p class="hint">Wordt gestopt: voor de volgende stap of zoekopdracht houdt hij op.</p>
      <% } else { %>
        <form method="post" action="/scan/deep/stoppen" class="stop-form">
          <button type="submit" class="button button-quiet">Stop dit onderzoek</button>
        </form>
      <% } %>
    </div>
  <% } %>
  <% if (run) { %>
    <div id="<%= job ? 'vorig-rapport' : 'rapport' %>" class="report">
      <%- include('partials/engine', {
        heading: job ? 'Rapport van je vorige Deep Scan' : 'Rapport van je laatste Deep Scan',
        sub: formatDateTime(run.ranAt),
        steps: run.steps,
        footnote: 'Een stap die niet voltooid is, staat hier met de reden. Wat nog niet bestaat, noemen we nooit voltooid.',
        more: { href: '/bronnen', text: 'Bronnen en roadmap' },
      }) %>
    </div>

    <article class="card" id="blootstelling">
      <header class="card-head">
        <h2>Mogelijk blootgestelde gegevens</h2>
        <% if (run.exposure.length > 0) { %><span class="badge badge-warn"><%= run.exposure.length === 1 ? '1 soort' : `${run.exposure.length} soorten` %></span><% } %>
      </header>
      <% if (run.exposure.length === 0) { %>
        <p class="card-text">In de bekende lekken herkennen we geen inloggegevens, telefoonnummers, adressen of betaalgegevens.</p>
      <% } else { %>
        <ul class="findings">
          <% for (const group of run.exposure) { %>
            <li class="finding">
              <h3><%= group.label %></h3>
              <p class="finding-meta">Zat in: <%= group.breaches.join(', ') %></p>
              <p class="finding-text"><%= group.advice %></p>
            </li>
          <% } %>
        </ul>
      <% } %>
      <p class="hint">
        We zien welke soorten gegevens een lek bevatte, niet de gegevens zelf en niet wat er van jou in stond:
        niet elk slachtoffer van een lek verloor elke soort gegeven. Of het over jouw gegevens gaat, kun je
        alleen nagaan bij de dienst zelf.
      </p>
    </article>
  <% } else { %>
    <article class="card" id="rapport">
      <header class="card-head">
        <h2>Deep Scan</h2>
        <span class="badge">Nog niet gedaan</span>
      </header>
      <p class="card-text">Je hebt nog geen Deep Scan gedaan. Dat doe je op je <a href="/dashboard">dashboard</a>.</p>
    </article>
  <% } %>

  <article class="card" id="datalekken">
    <header class="card-head">
      <h2>Datalekken</h2>
      <% if (breachScan) { %>
        <span class="badge <%= breaches.length > 0 ? 'badge-warn' : 'badge-ok' %>"><%= breaches.length %> gevonden</span>
      <% } %>
    </header>

    <% if (!breachScan) { %>
      <p class="card-text">Je hebt nog niet gezocht. Dat doe je op je <a href="/dashboard">dashboard</a>.</p>
    <% } else { %>
      <p class="hint notice-top">Laatst gecontroleerd op <%= formatDateTime(breachScan.ran_at) %>.</p>

      <% if (breaches.length === 0) { %>
        <p class="card-text">
          <%= checkSource.name %> kent je e-mailadres niet uit een datalek. Dat is geen garantie:
          niet elk lek is bekend.
        </p>
      <% } else { %>
        <ul class="findings">
          <% for (const breach of breaches) { %>
            <li class="finding">
              <h3><%= breach.title %></h3>
              <p class="finding-meta">
                <% if (breach.details.breachDate) { %>Gelekt op <%= formatDay(breach.details.breachDate) %><% } %>
                <% if (breach.details.breachDate && breach.details.pwnCount) { %> · <% } %>
                <% if (breach.details.pwnCount) { %><%= breach.details.pwnCount.toLocaleString('nl-NL') %> accounts<% } %>
              </p>
              <% if (breach.details.dataClasses && breach.details.dataClasses.length) { %>
                <ul class="chips" aria-label="Soorten gegevens in dit lek">
                  <% for (const item of breach.details.dataClasses) { %><li><%= dataClassLabel(item) %></li><% } %>
                </ul>
              <% } %>
              <% if (breach.details.description) { %>
                <p class="finding-text"><%= breach.details.description %></p>
              <% } %>
              <% if (breach.url) { %>
                <p class="finding-link">
                  <a href="<%= breach.url %>" target="_blank" rel="noopener noreferrer">Meer over dit datalek<%= sourceById(breach.details.source).id === 'hibp' ? ' bij Have I Been Pwned' : '' %></a>
                </p>
              <% } %>
              <%- include('partials/evidence', { finding: breach }) %>
            </li>
          <% } %>
        </ul>
        <p class="advice">
          <strong>Wat kun je doen?</strong> Gebruik voor elke dienst in dit lijstje een eigen,
          nieuw wachtwoord en zet tweestapsverificatie aan.
        </p>
      <% } %>
    <% } %>

    <% const shown = [...new Set([checkSource, ...breaches.map((item) => sourceById(item.details.source))])]; %>
    <p class="hint">
      Bron: <% shown.forEach((source, index) => { %><%= index > 0 ? ' en ' : '' %><a href="<%= source.url %>" target="_blank" rel="noopener noreferrer"><%= source.name %></a><%= source.credit ? ` (${source.credit})` : '' %><% }) %>.
    </p>
  </article>

  <article class="card" id="databrokers">
    <% const brokerMatches = brokers.filter((row) => row.outcome === 'overeenkomst'); %>
    <header class="card-head">
      <h2>Databrokers en telefoongidsen</h2>
      <% if (brokerMatches.length > 0) { %>
        <span class="badge badge-warn"><%= brokerMatches.length === 1 ? '1 met een overeenkomst' : `${brokerMatches.length} met een overeenkomst` %></span>
      <% } %>
    </header>
    <p class="card-text">
      Bij deze bedrijven zoeken we bij elke Deep Scan naar pagina's over jou, via de zoekdienst. We openen
      hun sites niet en gebruiken hun eigen zoekfunctie niet. We zien dus alleen wat een zoekmachine van
      hen kent, niet wat er in hun eigen database staat.
    </p>
    <p class="card-text">
      <strong>Overeenkomst gevonden</strong>: de titel of het fragment van een pagina noemt je volledige naam,
      je bevestigde telefoonnummer of je e-mailadres (bij een naam kan dat een naamgenoot zijn).
      <strong>Mogelijk relevante pagina</strong>: wel een pagina op die site, maar zonder je gegevens erin.
      <strong>Niets in de zoekmachine</strong> betekent niet dat ze niets over je hebben.
    </p>
    <% if (!searchAllowed) { %>
      <p class="hint">
        Zoeken op naam staat op deze site uit. Hier komt alleen iets te staan als we een databroker vinden via
        je bevestigde telefoonnummer of e-mailadres.
      </p>
    <% } %>
    <ul class="register-list broker-list">
      <% for (const row of brokers) { %>
        <li class="register-item" id="broker-<%= row.broker.id %>">
          <div class="register-top">
            <span class="register-name"><%= row.broker.name %></span>
            <span class="chip-soft"><%= row.broker.kind %></span>
            <span class="chip-soft"><%= row.broker.countries.join(', ') %></span>
            <span class="state state-<%= row.tone %>"><%= row.label %></span>
          </div>
          <p class="register-note">
            <%= row.broker.about %> Verwerkt volgens eigen opgave: <%= row.broker.data.join(', ') %>.
          </p>
          <p class="register-note">
            <% if (row.status === 'afgeschermd') { %>
              Afgeschermd: er zijn geen openbare pagina's om te doorzoeken. Wat dit bedrijf over je heeft, weet je
              alleen met een inzageverzoek (AVG artikel 15) of via een geautoriseerde gegevensdienst.
            <% } else if (row.checkedAt) { %>
              Laatst gecontroleerd op <%= formatDateTime(row.checkedAt) %><% if (row.status === 'gevonden') { %>:
              <%= row.found === 1 ? '1 pagina' : `${row.found} pagina's` %>, waarvan <%= row.matched %> met je gegevens in de titel of het fragment<% if (viaText(row.via)) { %>, gevonden via <%= viaText(row.via) %><% } %><% } %>.
              <% if (row.outcome === 'niets') { %>Dat betekent niet dat ze niets over je hebben.<% } %>
              <% if (!row.complete) { %>Mogelijk onvolledig: de zoekdienst gaf het maximum aantal resultaten.<% } %>
            <% } else { %>
              Nog niet gecontroleerd.
            <% } %>
            <a href="https://<%= row.broker.domain %>" target="_blank" rel="noopener noreferrer nofollow"><%= row.broker.domain %></a>
          </p>
        </li>
      <% } %>
    </ul>
    <p class="hint">
      Het register is nagekeken op <%= formatDay(brokersChecked) %>. Een bedrijf dat hier niet staat, is niet
      "veilig": dit is een korte, voorzichtige lijst.
    </p>
  </article>

  <article class="card" id="web">
    <header class="card-head">
      <h2>Op het web</h2>
      <% if (webScan && web.length > 0) { %><span class="badge"><%= web.length === 1 ? '1 mogelijke vermelding' : web.length + ' mogelijke vermeldingen' %></span><% } %>
    </header>

    <% if (!searchPolicy.configured) { %>
      <p class="alert alert-warning notice-top" role="note">
        <strong>Er is geen zoekdienst ingesteld.</strong> Daarom zoeken we niet op het web, en verzinnen we
        ook niets. Zet <code>BRAVE_API_KEY</code> in je <code>.env</code> (zie de README). Staat hij er al in?
        Start de site dan opnieuw (Ctrl+C en <code>npm start</code>): hij leest <code>.env</code> alleen bij het starten.
      </p>
    <% } %>

    <% if (!webScan) { %>
      <% if (searchPolicy.configured) { %>
        <p class="card-text">Je hebt nog niet gezocht. Dat doe je op je <a href="/dashboard">dashboard</a>.</p>
      <% } %>
    <% } else { %>
      <% if (searchPolicy.isDemo) { %>
        <p class="alert alert-warning notice-top" role="note">
          <strong>Voorbeeldresultaten.</strong> Dit is de demo: nepdata om te laten zien hoe het werkt.
          Er is niets naar buiten gestuurd.
        </p>
      <% } %>
      <p class="hint notice-top">
        Laatst gezocht op <%= formatDateTime(webScan.ran_at) %><% if (webScan.detail) { %> naar <code><%= webScan.detail %></code><% } %>.
        <% if (run && run.ranAt === webScan.ran_at) { %>
          Bij de Deep Scan zoeken we ook gericht bij databrokers, op sociale media en in documenten; welke
          zoekopdrachten liepen, staat in het rapport hierboven.
        <% } %>
      </p>

      <% if (web.length === 0 && webScan.found_count > 0 && !searchPolicy.retains && !searchPolicy.isDemo) { %>
        <p class="card-text">
          De resultaten van die zoekopdracht zijn verlopen. De zoekdienst staat niet toe dat we ze bewaren,
          dus ze blijven <%= searchPolicy.keepMinutes %> minuten staan. Zoek opnieuw op je
          <a href="/dashboard">dashboard</a> om ze weer te zien. Wat je eerder koos (Dit ben ik, Dit ben ik niet),
          onthouden we.
        </p>
      <% } else if (web.length === 0) { %>
        <p class="card-text">De zoekdienst vond niets bij deze zoekopdracht.</p>
      <% } else { %>
        <p class="card-text">
          Dit zijn <strong>mogelijke</strong> vermeldingen van jou, geen bewijs dat ze over jou gaan.
          Naamgenoten komen veel voor. Bij elk resultaat staat met welk gegeven we het vonden. Open de
          pagina, en kies dan wat klopt: pas bij "Dit ben ik" beschouwen we een resultaat als van jou.
        </p>
        <% if (!searchPolicy.retains && !searchPolicy.isDemo) { %>
          <% const until = Math.min(...web.map((item) => item.expires_at ?? Infinity)); %>
          <% if (Number.isFinite(until)) { %>
            <p class="hint">
              De zoekdienst staat niet toe dat we resultaten bewaren. Deze resultaten blijven zichtbaar tot
              uiterlijk <%= new Date(until).toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' }) %>.
              Jouw keuzes blijven bewaard.
            </p>
          <% } %>
        <% } %>
        <ul class="findings">
          <% for (const item of web) { %>
            <% const info = describeWebResult(item, { ownEmail: user.email, ownPhone: user.phone_verified_at ? user.phone : null }); %>
            <li class="finding" id="resultaat-<%= item.id %>">
              <h3><a href="<%= item.url %>" target="_blank" rel="noopener noreferrer nofollow"><%= item.title %></a></h3>
              <p class="finding-link"><%= item.url %></p>
              <p class="finding-meta">
                <span class="chip-soft"><%= info.site.label %></span>
                <% if (viaText(item.details.via)) { %><span class="chip-soft chip-via">Gevonden via <%= viaText(item.details.via) %></span><% } %>
              </p>
              <% if (item.details.snippet) { %>
                <p class="finding-text"><%= item.details.snippet %></p>
              <% } %>
              <% if (info.signals.length > 0) { %>
                <div class="signals">
                  <p class="signals-title">Dit lijkt in de titel of het fragment te staan (gemaskeerd):</p>
                  <ul class="chips" aria-label="Mogelijke persoonsgegevens in dit resultaat">
                    <% for (const signal of info.signals) { %>
                      <li><%= signal.label %>: <strong><%= signal.display %></strong><% if (signal.yours) { %> · <%= signal.kind === 'phone' ? 'komt overeen met je bevestigde telefoonnummer' : 'komt overeen met het e-mailadres van je account' %><% } %></li>
                    <% } %>
                  </ul>
                  <p class="hint">Het is een gok op basis van het uiterlijk. Of het van jou is, bepaal jij.</p>
                </div>
              <% } %>
              <% const page = item.details.page; %>
              <% if (page && page.status === 'gelezen') { %>
                <div class="page-check">
                  <p class="signals-title">
                    Pagina zelf gelezen op <%= formatDateTime(page.checkedAt) %>:
                    <% if (pageFoundText(page.found)) { %>
                      <%= pageFoundText(page.found) %> <%= page.found.length === 1 ? 'staat' : 'staan' %> erop.
                    <% } else { %>
                      je gegevens staan er niet (meer) op. Misschien is de pagina aangepast, of laadt hij zijn tekst pas later.
                    <% } %>
                  </p>
                  <% if (page.excerpt) { %><blockquote class="page-excerpt"><%= page.excerpt %></blockquote><% } %>
                </div>
              <% } else if (page) { %>
                <p class="hint">Pagina zelf niet gelezen: <%= pageReason(page.status) %>.</p>
              <% } %>
              <% const ai = item.details.ai; %>
              <% if (ai && aiVerdictText(ai.verdict)) { %>
                <div class="ai-check">
                  <p class="signals-title">
                    Inschatting van het AI-model (<%= ai.model %>), op basis van <%= ai.pageRead ? 'de pagina zelf' : 'de titel en het fragment' %>:
                    <strong><%= aiVerdictText(ai.verdict) %></strong>.
                  </p>
                  <% if (Array.isArray(ai.data) && ai.data.length > 0) { %>
                    <ul class="chips" aria-label="Gegevens die de AI letterlijk in de tekst vond">
                      <% for (const entry of ai.data) { %><li><%= aiDataLabel(entry.type) %>: <strong><%= aiQuote(entry) %></strong></li><% } %>
                    </ul>
                  <% } %>
                  <p class="hint">
                    <% if (Array.isArray(ai.data) && ai.data.length > 0) { %>Elk gegeven hierboven staat letterlijk in de tekst.<% } %>
                    <% if (ai.rejected > 0) { %><%= ai.rejected === 1 ? '1 bewering van de AI stond er niet letterlijk in en is weggegooid.' : `${ai.rejected} beweringen van de AI stonden er niet letterlijk in en zijn weggegooid.` %><% } %>
                    Een inschatting van de AI is geen bewijs: alleen jij weet of het over jou gaat.
                  </p>
                </div>
              <% } %>
              <%- include('partials/evidence', { finding: item }) %>
              <form method="post" action="/resultaten/<%= item.id %>" class="choices">
                <% for (const [value, label] of Object.entries(choices)) { %>
                  <button type="submit" name="status" value="<%= value %>"
                          class="button button-choice<%= item.status === value ? ' is-active' : '' %>"
                          aria-pressed="<%= item.status === value %>"><%= label %></button>
                <% } %>
              </form>
            </li>
          <% } %>
        </ul>
        <% const mineCount = web.filter((item) => item.status === 'mine').length; %>
        <% const newCount = web.filter((item) => item.status === 'new').length; %>
        <p class="advice">
          <%= mineCount === 1 ? '1 resultaat' : mineCount + ' resultaten' %> door jou bevestigd als "Dit ben ik".
          <% if (newCount > 0) { %>Nog te beoordelen: <%= newCount %>.<% } %>
        </p>
      <% } %>
    <% } %>
  </article>
</div>

<%- include('partials/foot') %>
