<%- include('partials/head', { title: 'Account maken' }) %>

<section class="card form-card">
  <h1>Account maken</h1>
  <p class="lead">Zie waar jouw gegevens online staan: in datalekken en in openbare bronnen. We zoeken en tonen; we verwijderen niets.</p>

  <% if (error) { %>
    <p class="alert alert-error" role="alert"><%= error %></p>
  <% } %>

  <form method="post" action="/registreren">
    <label for="naam">Je naam</label>
    <input id="naam" name="naam" autocomplete="name" required maxlength="80" value="<%= values.naam ?? '' %>">

    <label for="email">E-mailadres</label>
    <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email ?? '' %>">

    <label for="wachtwoord">Wachtwoord</label>
    <input id="wachtwoord" name="wachtwoord" type="password" autocomplete="new-password"
           required minlength="12" maxlength="128" aria-describedby="wachtwoord-uitleg">
    <p id="wachtwoord-uitleg" class="hint">
      Minimaal 12 tekens; een zinnetje van een paar woorden werkt prima.
      We checken anoniem of je wachtwoord in een bekend datalek voorkomt.
    </p>

    <label for="wachtwoord2">Herhaal je wachtwoord</label>
    <input id="wachtwoord2" name="wachtwoord2" type="password" autocomplete="new-password" required>

    <button type="submit" class="button button-primary">Account maken</button>
    <p class="hint">In de <a href="/privacy">privacyverklaring</a> lees je wat we met je gegevens doen.</p>
  </form>

  <p class="switch">Heb je al een account? <a href="/inloggen">Inloggen</a></p>
</section>

<%- include('partials/foot') %>
