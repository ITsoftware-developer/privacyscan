{
  "name": "privacyscan",
  "version": "0.7.0",
  "description": "Je eigen privacy-tool: wat weet het internet over jou? Zoekt en toont wat er over jou te vinden is, nu in bekende datalekken en (met een zoekdienst) op het web, met bron, datum en zekerheid bij elke bevinding. Verwijdert niets, en verzint niets.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "controleer": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/controleer-bronnen.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "test:coverage": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-exclude=test/** \"test/*.test.js\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1"
  }
}
